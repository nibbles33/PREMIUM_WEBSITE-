# Server-only — never commit real values. Set in Vercel Production / Preview.

# Required for Contact, Quote, and Careers form persistence (Neon / Vercel Postgres)
DATABASE_URL=

# Required for broker email notifications (Contact, Quote, Careers)
RESEND_API_KEY=

# Production sender — must be a Resend-verified domain address (defaults to onboarding@resend.dev sandbox)
# RESEND_FROM_EMAIL=website@premiumib.com

# Careers resume upload — Vercel Private Blob (premium-website-blob)
# Prefer OIDC on Vercel: store id is enough (VERCEL_OIDC_TOKEN is injected).
# Accept either the standard name or the existing Vercel-prefixed name — do not
# rename/delete Vercel-managed vars blindly.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN_STORE_ID=
# Optional legacy fallback only (not required when OIDC + store id work):
# BLOB_READ_WRITE_TOKEN=
# Webhook key from Blob store connection (unused by Careers put; leave as-is):
# BLOB_READ_WRITE_TOKEN_WEBHOOK_PUBLIC_KEY=

# Optional overrides (defaults to info@premiumib.com)
# CONTACT_NOTIFY_TO=
# QUOTE_NOTIFY_TO=
# CAREERS_NOTIFY_TO=

# Homepage live Google rating/review count (Places API New — server-side only)
# Restrict key to Places API (New) Place Details; never expose in NEXT_PUBLIC_* or client JS.
# GOOGLE_PLACES_API_KEY=
